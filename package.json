{
  "name": "food-memory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/with-local-db.mjs node node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests next.config.ts vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/with-local-db.mjs node node_modules/vitest/vitest.mjs run tests/db/search.test.ts",
    "test:rest": "node scripts/check-rest.mjs",
    "test:http": "node scripts/with-local-db.mjs node scripts/check-http.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local",
    "db:check": "node scripts/check-db.mjs",
    "db:status": "supabase status"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
