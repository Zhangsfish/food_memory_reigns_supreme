# Optional S02+ browser configuration. Leave blank for S00; copy to .env.local only when configured.
# Only NEXT_PUBLIC_ values may be exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public canonical origin used by server-rendered pages and JSON links.
# Set to the deployed HTTPS origin in S05; S01 local defaults to localhost:3000.
SITE_URL=http://localhost:3000

# Server-only S02+ value; never use in browser code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# S01+ server-only PostgreSQL connection. For local work, use `npm run dev:local`
# after `npm run db:start`; it reads the CLI's local DB_URL without storing it.
# For a configured server, replace every placeholder and keep the value secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# S03+ AI provider adapter; no provider calls occur in S00.
AI_PROVIDER=
AI_API_KEY=
EMBEDDING_MODEL=
EXTRACTION_MODEL=

# Feature gates
PUBLIC_SIGNUP_ENABLED=false
PUBLIC_SUBMISSION_ENABLED=false
